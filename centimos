denominaciones = [20000, 10000, 5000, 2000, 1000, 500, 200, 100, 50, 20, 10, 5]

soles, centimos = input("¿Cuánto se va a pagar? S/ ").split(".")
monto = int(soles) * 100 + int(centimos)

print("\nRespuesta:")
for valor in denominaciones:
    cantidad = monto // valor
    monto = monto % valor
    if cantidad > 0:
        print(cantidad, "de S/", valor / 100)